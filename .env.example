# Copy to ~/.jarvis.env (NOT into the repo). Every value here is a secret or machine-local.
# config.py reads this file; nothing else in the package touches the environment.

# LiteLLM proxy (port 4000). The gateway authenticates to LiteLLM with the master key.
LITELLM_BASE=http://localhost:4000/v1
LITELLM_MASTER_KEY=sk-change-me-to-a-long-random-string

# LiteLLM state store (Neon Postgres free tier). Includes the password: rotate if it ever leaks.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require

# Neo4j AuraDB (RAG graph)
NEO4J_URI=neo4j+s://xxxxxxxx.databases.neo4j.io
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me

# Ollama on this machine
OLLAMA_BASE_URL=http://localhost:11434
EMBED_MODEL=nomic-embed-text

# Gateway API key (clients such as Open WebUI and Continue send this as a bearer token). Enforced from v2.
JARVIS_API_KEY=change-me-to-a-long-random-string
